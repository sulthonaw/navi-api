# Environment Configuration
PROJECT_NAME="Navi Exam & Socratic Engine API"
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL default for Docker, SQLite fallback for local test)
POSTGRES_USER=navi_user
POSTGRES_PASSWORD=navi_password
POSTGRES_DB=navi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://navi_user:navi_password@postgres:5432/navi_db

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS
CORS_ORIGINS=["*"]

# Code Execution Sandbox
EXECUTION_TIMEOUT_SECONDS=5.0
PISTON_URL=
